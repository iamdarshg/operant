[Unit]
Description=Operant Discord bot (the chat interface to the control plane)
Documentation=file:///opt/operant-src/operant/apps/bot
After=network-online.target operant-api.service
Wants=network-online.target operant-api.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=iamdarshg
Group=iamdarshg
WorkingDirectory=/opt/operant-src/operant/apps/bot
# Tokens come from the same .env as the control plane, never from this file.
EnvironmentFile=/opt/operant-src/operant/.env
Environment=NODE_ENV=production
Environment=OPERANT_API_BASE=http://127.0.0.1:8787
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# The bot needs the network and its own dist; it does not write files.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/operant-src/operant/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target