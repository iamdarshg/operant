# Operant configuration. Copy to `.env` and fill in the credentials.
# NEVER commit a real `.env`. Nothing here needs an absolute host path except
# DSH_CREDENTIALS_FILE, which points at your own credentials file.

NODE_ENV=production
LOG_LEVEL=info

# ---- database -------------------------------------------------------------
# compose overrides this to the internal service name; only used when running
# the processes outside compose.
DATABASE_URL=postgres://operant@127.0.0.1:55432/operant

# ---- control plane --------------------------------------------------------
OPERANT_API_PORT=8787
OPERANT_API_HOST=127.0.0.1
# Bearer token shared by the Discord bot / dashboard. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 16 characters or the API refuses to start (fail-closed).
OPERANT_BOT_TOKEN=replace-with-a-long-random-token

# ---- DSH agent runtime ----------------------------------------------------
# NOTE: do NOT name these DSH_*. DSH reserves that prefix for the launching
# environment and refuses to boot if a .env in the working directory sets one.
OPERANT_DSH_PROFILE=operant
OPERANT_WORKSPACE_ROOT=/app/data/jobs
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MS=900000

# Host path to the DSH credentials file (SURPLUS_API_KEY / ANTSEED_API_KEY).
# Mounted read-only into the containers.
DSH_CREDENTIALS_FILE=./secrets/.credentials.yaml

# ---- speech (optional `voice` profile) ------------------------------------
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900
VOICESTUDIO_MCP_URL=http://127.0.0.1:3900/mcp/
OMNIVOICE_ASR_BACKEND=faster-whisper
ASR_MODEL_FASTER=Systran/faster-whisper-small
OMNIVOICE_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,voicestudio,operant-core

# ---- Discord (deferred; needs an operator-created bot token) --------------
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# ---- dashboard ------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787