# ---- Operant configuration (copy to .env, never commit real values) ----
NODE_ENV=development
LOG_LEVEL=info

# Postgres (durable jobs, memory, audit)
DATABASE_URL=postgres://operant:CHANGE_ME_DEV_PASSWORD@127.0.0.1:5432/operant
# Redis (queue, presence, rate limits)
REDIS_URL=redis://127.0.0.1:6379

# Control-plane auth
OPERANT_API_BASE=http://127.0.0.1:8787
OPERANT_SESSION_SECRET=change-me-64-hex-chars
OPERANT_BOT_TOKEN=change-me-bot-api-token

# DSH runtime
DSH_BIN=dsh
DSH_PROFILE=headless
DSH_WORKSPACE_ROOT=D:\CodeProjects\operant\data\jobs
DSH_PERMISSION_MODE=workspace-write

# Discord (supplied manually - never commit)
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# VoiceStudio (cloud-hosted speech service)
VOICESTUDIO_BASE_URL=http://127.0.0.1:8501
VOICESTUDIO_MCP_URL=http://127.0.0.1:8501/mcp/
VOICESTUDIO_MCP_TOKEN=
VOICESTUDIO_ASR_MODEL=small
VOICESTUDIO_ASR_MODEL_ACCURATE=large-v3

# Dashboard
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787

