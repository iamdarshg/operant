{
  "name": "@operant/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "operant-bot": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "node dist/index.js --check"
  },
  "dependencies": {
    "undici": "7.2.0",
    "discord.js": "14.17.2",
    "zod": "3.24.1",
    "@operant/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "typescript": "5.7.2",
    "@types/node": "22.10.2"
  }
}
