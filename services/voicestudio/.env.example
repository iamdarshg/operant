# Copy to .env next to compose.yaml on the VM (compose reads it automatically).
# Every value here is optional; compose.yaml carries working defaults.

# Which ASR engine answers /v1/audio/transcriptions. On a CPU-only box
# faster-whisper is the sane default (WhisperX would pull large-v3 + an
# alignment model and run ~3x slower than this engine does at `medium`).
OMNIVOICE_ASR_BACKEND=faster-whisper
# CTranslate2 repo id. Benchmarked: small = 0.248 RTF / 1.5 GiB RSS;
# medium = 0.643 RTF / 2.1 GiB RSS; both 0% WER on the bench clip.
ASR_MODEL_FASTER=Systran/faster-whisper-small

# Host names the MCP SDK will accept in the Host header. Add the Tailscale
# MagicDNS name (e.g. operant-core.tailXXXX.ts.net) once tailscale is up,
# otherwise remote MCP clients get "Invalid Host header" 403s.
OMNIVOICE_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,operant-core

# Thread caps for CPU inference. 8 vCPU box; 4 keeps two concurrent ASR
# requests from fighting over the same cores.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4